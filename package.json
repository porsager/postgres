{
  "name": "postgres",
  "version": "4.0.0-dev",
  "description": "Fastest full featured PostgreSQL client for Node.js, Bun and Cloudflare Workers",
  "type": "module",
  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "workerd": "./src/cf.js",
      "default": "./src/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tests/unit && node tests/index.js && node tests/simulate.js",
    "test:unit": "node tests/unit",
    "test:integration": "node tests/index.js",
    "test:simulate": "node tests/simulate.js",
    "coverage": "node tests/coverage.js",
    "test:types": "cd types && npm install && npm test",
    "test:cf": "sh tests/cf/run.sh",
    "lint": "eslint src tests"
  },
  "files": [
    "/src/*.js",
    "/types/index.d.ts"
  ],
  "author": "Rasmus Porsager <rasmus@porsager.com> (https://www.porsager.com)",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/porsager"
  },
  "license": "Unlicense",
  "repository": "porsager/postgres"
}
